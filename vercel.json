{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build --workspace @career-os/web",
  "outputDirectory": "apps/web/.next",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "17 8 * * *"
    }
  ]
}
