NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Vercel/server only. Never expose to browser code or the local worker.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
CAREER_OS_APP_URL=http://localhost:3000
CAREER_OS_OAUTH_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
CAREER_OS_WORKER_PAIRING_PEPPER=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=replace-with-resend-key
RESEND_FROM_EMAIL=career-os@example.com
RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-secret
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-web-client-secret
GITHUB_OAUTH_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Local worker behavior. The paired worker stores its device secret with DPAPI;
# it does not receive Supabase service credentials.
CAREER_OS_GATEWAY_URL=http://localhost:3000
CAREER_OS_WORKER_POLL_MS=10000
CAREER_OS_RUNTIME=codex-app-server
CAREER_OS_LATEX_ENGINE=pdflatex
# Optional when MiKTeX is not discoverable automatically.
CAREER_OS_LATEX_PATH=C:\Users\you\AppData\Local\Programs\MiKTeX\miktex\bin\x64\pdflatex.exe
